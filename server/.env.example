# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=https://architect-portal-mumd.onrender.com

# Database
MONGO_URI=

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRY=1d
JWT_REFRESH_EXPIRY=7d

# Initial owner seed (only used the FIRST time you run `npm run seed:owner`)
SEED_OWNER_USERNAME=admin
SEED_OWNER_PASSWORD=changeMe!

# --- Used in later phases (Cloudinary, Nodemailer, WhatsApp) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
